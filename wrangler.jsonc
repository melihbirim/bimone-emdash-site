{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bimone-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bimone-emdash-site","database_id": "058a72f8-7bae-4275-88aa-dfd704c24d55",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "bimone-emdash-media","preview_bucket_name": "bimone-emdash-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
